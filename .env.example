# General
DEBUG=True

# Redis (L1 backend / rate limiter, optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenAI (optional backend)
OPENAI_API_KEY=sk-...

# Cache policy
SIMILARITY_THRESHOLD=0.9
PROMOTION_THRESHOLD=0.95
L1_MAX_SIZE=10000
L1_TTL_SECONDS=3600
L1_LOWERCASE=true

# Rate limiting (fixed window, keyed by client IP)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
